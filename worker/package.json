{
	"name": "ledger-worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build:page": "node build-page.mjs",
		"test": "node build-page.mjs && vitest run",
		"type-check": "node build-page.mjs && tsc --noEmit",
		"check-bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run -c ../wrangler.toml",
		"deploy": "wrangler deploy -c ../wrangler.toml"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.133.0",
		"@cloudflare/workers-oauth-provider": "0.8.3",
		"@modelcontextprotocol/sdk": "1.32.2",
		"unpdf": "1.8.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "6.0.3",
		"vitest": "3.2.7",
		"wrangler": "4.105.0"
	}
}
